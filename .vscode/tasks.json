{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run phosphobot (can_piper)",
      "type": "shell",
      "command": "make",
      "args": [
        "CAN_INTERFACE=can_piper"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Serve SmolVLA (remote inference)",
      "type": "shell",
      "command": "source smolvla-piper/bin/activate && phosphobot serve-smolvla --model-id anhrisn/piper-smolvla-001 --host 0.0.0.0 --port 8090",
      "options": {
        "cwd": "${workspaceFolder}/phosphobot"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
