\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Reach-field on the competent ($74\%$) SmolVLA checkpoint.} (a) Clean-conditioned reach endpoints $\mathbf  {E}$ in the displacement frame ($x$ along $\mathbf  {d}=\mathbf  {T}-\mathbf  {C}$); green star $=$ canonical/training location $\mathbf  {C}$, red cross $=$ displaced object $\mathbf  {T}$. The endpoint error is $\mathbf  {e}=\mathbf  {E}-\mathbf  {T}$, and our statistic $\operatorname  {cos}(\mathbf  {e},-\mathbf  {d})>0$ means the reach points back toward $\mathbf  {C}$ (the canonical prior). (b) The alignment $\operatorname  {cos}(\mathbf  {e},-\mathbf  {d})$ increases monotonically with displacement while displaced success collapses.\relax }}{4}{figure.caption.15}\protected@file@percent }
\newlabel{fig:e1r}{{1}{4}{\textbf {Reach-field on the competent ($74\%$) SmolVLA checkpoint.} (a) Clean-conditioned reach endpoints $\Ev $ in the displacement frame ($x$ along $\dv =\Tv -\Cv $); green star $=$ canonical/training location $\Cv $, red cross $=$ displaced object $\Tv $. The endpoint error is $\ev =\Ev -\Tv $, and our statistic $\cossim (\ev ,-\dv )>0$ means the reach points back toward $\Cv $ (the canonical prior). (b) The alignment $\cossim (\ev ,-\dv )$ increases monotonically with displacement while displaced success collapses.\relax }{figure.caption.15}{}}
\newlabel{fig:e1r@cref}{{[figure][1][]1}{[1][4][]4}}
